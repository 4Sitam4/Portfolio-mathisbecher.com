---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/global.css';
import '../styles/provision.css';
import BootSequence from '../components/BootSequence.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);
const canonical = new URL(lang === 'fr' ? '/' : '/en/', Astro.site);
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <meta name="theme-color" content="#070b09" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
    <meta property="og:site_name" content="mathisbecher.com" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mathis Becher — Cloud Infrastructure Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="author" content="Mathis Becher" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Mathis Becher',
        url: 'https://mathisbecher.com',
        jobTitle: 'Cloud Infrastructure Engineer',
        image: ogImage,
        email: 'mailto:contact@mathisbecher.com',
        address: { '@type': 'PostalAddress', addressLocality: 'Strasbourg', addressCountry: 'FR' },
        knowsLanguage: ['fr', 'en'],
        knowsAbout: ['Terraform', 'Terramate', 'Microsoft Azure', 'Kubernetes', 'Docker', 'Proxmox', 'Go', 'Infrastructure as Code'],
        worksFor: { '@type': 'Organization', name: 'Open Lake Technology' },
        sameAs: ['https://github.com/4Sitam4', 'https://www.linkedin.com/in/mathisbecher/'],
      })}
    />

    <!-- Decide before first paint whether the boot sequence should run
         (every visit, except with reduced motion). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        // Reading mode, chosen by the visitor (ReadingMode.astro).
        var calm = false;
        try {
          calm = localStorage.getItem('mb-calm') === '1';
        } catch (e) {}
        if (calm) root.dataset.calm = 'true';
        // Every visit: boot + "terraform apply" build, so every resource starts
        // hidden ('pv'). With reduced motion there is no show at all.
        // animations.ts takes over this class; the timeout is a safety net so
        // content can never stay hidden if the script fails to load.
        if (calm || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.dataset.booted = 'true';
        } else {
          root.classList.add('pv');
          setTimeout(function () {
            root.classList.remove('pv');
          }, 8000);
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t('skip')}</a>
    <BootSequence lang={lang} />
    <slot />
    <script src="../scripts/animations.ts"></script>
  </body>
</html>
