---
import Base from '../layouts/Base.astro';
---

<Base lang="fr" title="404, Mathis Becher" description="Page introuvable / Page not found" noindex boot={false}>
  <main id="main" class="notfound container">
    <h1 class="notfound__code mono num">404<span class="visually-hidden"> : page introuvable</span></h1>
    <pre class="notfound__pre mono"><span class="notfound__sign">$</span> curl -sI mathisbecher.com<span id="nf-path"></span>
HTTP/1.1 404 Not Found</pre>
    <!-- The page is built once, so the requested path is only known in the browser. -->
    <script is:inline>
      document.getElementById('nf-path').textContent = location.pathname;
    </script>
    <p class="notfound__text">
      Cette page n'existe pas.<br />
      <span lang="en">This page does not exist.</span>
    </p>
    <div class="notfound__actions">
      <a href="/" class="btn btn--primary">Retour à l'accueil</a>
      <a href="/en/" class="btn" lang="en">Back to home</a>
    </div>
  </main>
</Base>

<style>
  .notfound {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--s-5);
  }

  .notfound__code {
    font-size: clamp(5rem, 15vw, 9rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .notfound__pre {
    color: var(--text-3);
    font-size: var(--fs-sm);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .notfound__sign {
    color: var(--accent);
  }

  .notfound__text {
    color: var(--text-2);
    font-size: var(--fs-lg);
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
</style>
