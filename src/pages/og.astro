---
/**
 * Source of the link-preview image (og.png, 1200×630). Screenshotted at build
 * time by scripts/render-assets.mjs, then removed from the output.
 */
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-400.css';

// Deterministic "rain": same image on every build.
let seed = 42;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const GLYPHS = '0123456789ABCDEFXYZ<>/=+*#$%&{}[];:';
const columns = Array.from({ length: 50 }, (_, i) => {
  const length = 4 + Math.floor(rand() * 12);
  return {
    x: i * 24 + 4,
    y: Math.floor(rand() * 600) - 160,
    glyphs: Array.from({ length }, () => GLYPHS[Math.floor(rand() * GLYPHS.length)]),
    show: rand() > 0.35,
  };
}).filter((c) => c.show);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>og</title>
  </head>
  <body>
    <div class="card">
      <div class="rain" aria-hidden="true">
        {
          columns.map((c) => (
            <div class="col" style={`left:${c.x}px;top:${c.y}px`}>
              {c.glyphs.map((g, j) => (
                <span style={`opacity:${((j + 1) / c.glyphs.length) ** 2 * 0.5}`}>{g}</span>
              ))}
            </div>
          ))
        }
      </div>

      <div class="left">
        <p class="prompt">$ whoami</p>
        <h1>Mathis Becher</h1>
        <p class="role">Cloud Infrastructure Engineer</p>
        <p class="stack">Terraform · Azure · Kubernetes · Docker · Proxmox</p>
      </div>

      <div class="window">
        <div class="window__bar"><i></i><i></i><i></i><span>curl -sI mathisbecher.com</span></div>
        <div class="window__body">
          <p><b>$</b> curl -sI https://mathisbecher.com/</p>
          <p class="ok">HTTP/1.1 200 OK</p>
          <p><span>served from:</span> my homelab</p>
          <p class="route"><span>route:</span> you → cloudflare → firewall → proxmox → <em>nginx</em></p>
        </div>
      </div>

      <p class="url"><i></i>mathisbecher.com</p>
    </div>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: #070b09;
  }

  .card {
    position: relative;
    width: 1200px;
    height: 630px;
    padding: 96px 80px 0;
    color: #e4ede8;
    font-family: 'IBM Plex Sans', sans-serif;
    background:
      radial-gradient(900px 500px at 15% 40%, rgba(0, 255, 157, 0.07), transparent 70%),
      #070b09;
    overflow: hidden;
  }

  .rain {
    position: absolute;
    inset: 0;
    font: 400 18px/24px 'JetBrains Mono', monospace;
    color: #00ff9d;
    -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.25), #000 70%);
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.25), #000 70%);
  }

  .col {
    position: absolute;
    display: flex;
    flex-direction: column;
    width: 24px;
    text-align: center;
  }

  .left {
    position: relative;
  }

  .prompt {
    color: #00ff9d;
    font: 400 26px 'JetBrains Mono', monospace;
  }

  h1 {
    margin-top: 18px;
    font: 500 92px/1 'JetBrains Mono', monospace;
    letter-spacing: -0.03em;
  }

  .role {
    margin-top: 24px;
    font: 400 34px 'JetBrains Mono', monospace;
  }

  .stack {
    margin-top: 22px;
    color: #a3b6ad;
    font-size: 24px;
  }

  .window {
    position: absolute;
    right: 56px;
    bottom: 48px;
    width: 540px;
    border: 1px solid rgba(228, 237, 232, 0.16);
    border-radius: 12px;
    background: rgba(12, 18, 15, 0.92);
    font: 400 17px/1.7 'JetBrains Mono', monospace;
  }

  .window__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(228, 237, 232, 0.08);
    color: #7f958b;
    font-size: 14px;
  }

  .window__bar i {
    width: 11px;
    height: 11px;
    border: 1px solid #7f958b;
    border-radius: 50%;
  }

  .window__bar span {
    margin-left: 8px;
  }

  .window__body {
    padding: 16px 20px 18px;
  }

  .window__body b {
    color: #00ff9d;
    font-weight: 400;
  }

  .window__body span {
    color: #7f958b;
  }

  .ok {
    color: #e4ede8;
  }

  .route {
    font-size: 14px;
    white-space: nowrap;
  }

  .route em {
    color: #00ff9d;
    font-style: normal;
  }

  .url {
    position: absolute;
    left: 80px;
    bottom: 56px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: #a3b6ad;
    font: 400 22px 'JetBrains Mono', monospace;
  }

  .url i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #00ff9d;
    box-shadow: 0 0 14px #00ff9d;
  }
</style>
