---
import SectionHeading from './SectionHeading.astro';
import Rich from './Rich.astro';
import Icon from './Icon.astro';
import Tags from './Tags.astro';
import { useTranslations, timeline, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="experience" class="section">
  <div class="container">
    <SectionHeading title={t('xp.title')} name="experience" />

    <ol class="xp">
      {
        timeline.map((entry, i) => {
          const current = i === 0;
          return (
            <li class:list={['xp__item', current && 'is-current']} data-provision={`experience.entry[${i}]`}>
              <div class="xp__when mono">
                <span class="xp__period num">{entry.period[lang]}</span>
                <span class="xp__type">
                  <Icon name={entry.type === 'work' ? 'briefcase' : 'graduation'} />
                  {current ? t('xp.now') : entry.type === 'work' ? t('xp.work') : t('xp.edu')}
                </span>
              </div>
              <div class="xp__body">
                <h3 class="xp__title">{entry.title[lang]}</h3>
                <p class="xp__org">
                  {entry.org}<span class="xp__loc"><Icon name="pin" />{entry.location[lang]}</span>
                </p>
                <p class="xp__desc"><Rich text={entry.description[lang]} /></p>
                <Tags items={entry.tags} />
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .xp {
    border-top: 1px solid var(--line);
  }

  .xp__item {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: var(--s-6);
    padding-block: var(--s-6);
    border-bottom: 1px solid var(--line);
  }

  .xp__when {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding-top: 2px;
    font-size: var(--fs-sm);
  }

  .xp__period {
    color: var(--text-2);
  }

  .xp__type {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  .is-current .xp__type {
    color: var(--accent);
  }

  .xp__title {
    font-family: var(--font-sans);
    font-size: var(--fs-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .xp__org {
    margin-top: var(--s-1);
    color: var(--text);
  }

  .xp__loc {
    color: var(--text-3);
  }

  .xp__desc {
    max-width: 65ch;
    margin-top: var(--s-3);
    margin-bottom: var(--s-4);
    color: var(--text-2);
  }

  @media (max-width: 760px) {
    .xp__item {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
      padding-block: var(--s-5);
    }

    .xp__when {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
