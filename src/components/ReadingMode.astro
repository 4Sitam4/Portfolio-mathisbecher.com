---
/**
 * Reading mode: no boot, no build/destroy, no rain — just the text.
 * The choice is kept in this browser (localStorage `mb-calm`); the pre-paint
 * script in Base.astro reads it and takes the same path as reduced motion.
 * Hidden when the OS already asks for reduced motion.
 */
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<button type="button" class="calm-toggle" id="calm-toggle" aria-pressed="false" title={t('calm.label')}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z" /><path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z" />
  </svg>
  <span>{t('calm.on')}</span>
</button>

<style>
  .calm-toggle {
    position: fixed;
    top: var(--s-4);
    right: var(--s-4);
    z-index: var(--z-nav);
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    height: 2.75rem;
    padding: 0 var(--s-4);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    background: rgba(12, 18, 15, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .calm-toggle:hover {
    color: var(--accent);
  }

  .calm-toggle[aria-pressed='true'] {
    color: var(--accent);
    border-color: rgba(0, 255, 157, 0.4);
  }

  .calm-toggle svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 480px) {
    .calm-toggle {
      width: 2.75rem;
      padding: 0;
      justify-content: center;
    }

    .calm-toggle span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .calm-toggle {
      display: none;
    }
  }
</style>

<script>
  const KEY = 'mb-calm';
  const button = document.getElementById('calm-toggle');
  const calm = document.documentElement.dataset.calm === 'true';
  button?.setAttribute('aria-pressed', String(calm));
  button?.addEventListener('click', () => {
    try {
      if (calm) localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, '1');
    } catch {
      return; // storage blocked: the mode could not survive the reload
    }
    location.reload();
  });
</script>
