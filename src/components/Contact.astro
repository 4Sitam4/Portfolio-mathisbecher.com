---
import { useTranslations, contactLinks, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="section container contact">
  <h2 class="section-heading">
    <span class="index mono">07.</span>
    <span data-decrypt>{t('contact.title')}</span>
  </h2>

  <div class="contact__box" data-reveal>
    <p class="mono code-comment">$ echo $CONTACT</p>
    <p class="contact__intro">{t('contact.intro')}</p>

    <a class="btn btn--primary contact__cta" href={`mailto:${contactLinks.email}`}>
      [ {t('contact.cta')} ]
    </a>

    <ul class="contact__links mono" data-reveal-group>
      <li>
        <span class="accent">├─</span>
        <a href={`mailto:${contactLinks.email}`}>{contactLinks.email}</a>
      </li>
      <li>
        <span class="accent">├─</span>
        <a href={contactLinks.github} target="_blank" rel="noopener noreferrer">github.com/4Sitam4 ↗</a>
      </li>
      <li>
        <span class="accent">└─</span>
        <a href={contactLinks.linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/mathisbecher ↗</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .contact__box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
    padding-block: var(--space-5);
  }

  .contact__intro {
    max-width: 42ch;
    color: var(--text-muted);
    font-size: var(--fs-lg);
  }

  .contact__cta {
    font-size: var(--fs-base);
    padding: 1rem 2rem;
  }

  .contact__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    text-align: left;
  }
</style>
