---
import SectionHeading from './SectionHeading.astro';
import Rich from './Rich.astro';
import { useTranslations, contactLinks, type Lang } from '../i18n/ui';
import { cvPdf } from '../i18n/cv';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const channels = [
  {
    label: 'E-mail',
    value: contactLinks.email,
    href: `mailto:${contactLinks.email}`,
    icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  },
  {
    label: 'GitHub',
    value: 'github.com/4Sitam4',
    href: contactLinks.github,
    icon: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/mathisbecher',
    href: contactLinks.linkedin,
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  },
  {
    label: t('cv.channel'),
    value: t('cv.channel.value'),
    href: cvPdf[lang],
    icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M12 11v6"/><path d="m9 14 3 3 3-3"/>',
  },
];
---

<section id="contact" class="section">
  <div class="container">
    <SectionHeading title={t('contact.title')} name="contact" />

    <div class="contact">
      <div class="contact__main" data-provision="contact.mail">
        <p class="contact__intro"><Rich text={t('contact.intro')} /></p>
        <div class="contact__actions">
          <a class="btn btn--primary" href={`mailto:${contactLinks.email}`}>{t('contact.cta')}</a>
          <button
            type="button"
            class="btn"
            id="copy-email"
            data-email={contactLinks.email}
            data-done={t('contact.copied')}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
            </svg>
            <span class="copy-label">{t('contact.copy')}</span>
          </button>
        </div>
        <p class="visually-hidden" id="copy-status" role="status" aria-live="polite"></p>
      </div>

      <ul class="channels" data-provision="contact.channels">
        {
          channels.map((c) => {
            const external = c.href.startsWith('http') || c.href.endsWith('.pdf');
            return (
              <li>
                <a
                  class="channel"
                  href={c.href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  <svg
                    class="channel__icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={c.icon}
                  />
                  <span class="channel__label">{c.label}</span>
                  <span class="channel__value mono">{c.value}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--s-8);
    align-items: start;
  }

  .contact__intro {
    max-width: 30ch;
    font-size: var(--fs-2xl);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .channels {
    border-top: 1px solid var(--line);
  }

  .channel {
    display: grid;
    grid-template-columns: 18px 6rem minmax(0, 1fr);
    align-items: center;
    gap: var(--s-3);
    min-height: 3.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--text-2);
    transition: color var(--dur-fast) var(--ease);
  }

  .channel__icon {
    width: 18px;
    height: 18px;
    color: var(--text-3);
    transition: color var(--dur-fast) var(--ease);
  }

  .channel__label {
    font-size: var(--fs-sm);
    color: var(--text-3);
  }

  .channel__value {
    font-size: var(--fs-sm);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .channel:hover {
    color: var(--text);
  }

  .channel:hover .channel__icon {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-7);
    }

    .contact__intro {
      font-size: var(--fs-xl);
    }
  }

  @media (max-width: 420px) {
    .channel {
      grid-template-columns: 18px minmax(0, 1fr);
    }

    .channel__label {
      display: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('copy-email') as HTMLButtonElement | null;
  const status = document.getElementById('copy-status');
  const label = btn?.querySelector('.copy-label');
  const original = label?.textContent ?? '';
  let timer = 0;

  btn?.addEventListener('click', async () => {
    const email = btn.dataset.email ?? '';
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      // Clipboard blocked (insecure context, old browser): fall back to the mail client.
      window.location.href = `mailto:${email}`;
      return;
    }
    if (label) label.textContent = btn.dataset.done ?? '';
    if (status) status.textContent = btn.dataset.done ?? '';
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      if (label) label.textContent = original;
      if (status) status.textContent = '';
    }, 2400);
  });
</script>
