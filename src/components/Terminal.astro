---
import SectionHeading from './SectionHeading.astro';
import Window from './Window.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const suggestions = ['help', 'ls', 'cd projects', 'tree', 'nano notes.txt', 'fastfetch', 'fortune', 'terraform apply'];
---

<section id="terminal" class="section">
  <div class="container">
    <SectionHeading title={t('term.title')} name="terminal" />

    <div class="term-intro" data-provision="terminal.hints">
      <p class="term-intro__hint">{t('term.hint')}</p>
      <ul class="term-intro__cmds">
        {
          suggestions.map((cmd) => (
            <li>
              <button type="button" class="kbd term-intro__cmd" data-term-cmd={cmd}>
                {cmd}
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <Window id="term" title="visitor@mathisbecher.com: ~" class="term" provision="terminal.shell">
      <div id="term-body" class="term__body">
        <div id="term-out" class="term__out" role="log" aria-live="polite"></div>
        <div class="term__input-row">
          <label class="term__prompt" for="term-input">
            <span class="term__user">visitor@mathisbecher</span><span class="term__colon" id="term-cwd">:~$</span>
          </label>
          <input
            id="term-input"
            class="term__input"
            type="text"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="send"
            aria-label={t('term.input')}
          />
        </div>
      </div>

      <div id="nano" class="nano" hidden>
        <div class="nano__head">
          <span>GNU nano 7.2</span>
          <span class="nano__file"></span>
          <span class="nano__mod"></span>
        </div>
        <textarea
          class="nano__text"
          spellcheck="false"
          autocapitalize="off"
          autocomplete="off"
          aria-label={lang === 'fr' ? 'Éditeur de texte nano' : 'nano text editor'}></textarea>
        <p class="nano__status" role="status" aria-live="polite"></p>
        <div class="nano__keys"></div>
      </div>
    </Window>
  </div>
</section>

<style>
  .term-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
    margin-bottom: var(--s-5);
  }

  .term-intro__hint {
    color: var(--text-2);
  }

  .term-intro__cmds {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .term-intro__cmd {
    min-height: 2rem;
    padding: 0 var(--s-3);
    font-size: var(--fs-sm);
    transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .term-intro__cmd:hover {
    background: #18221d;
    border-color: rgba(228, 237, 232, 0.22);
  }

  .term-intro__cmd:active {
    transform: translateY(1px);
  }

  .term__body {
    height: 24rem;
    overflow-y: auto;
    padding: var(--s-4) var(--s-5);
    font-size: var(--fs-sm);
    line-height: 1.7;
    cursor: text;
  }

  .term__out {
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--text);
  }

  .term__out :global(.term-line--accent) {
    color: var(--accent);
  }

  .term__out :global(.term-line--art) {
    color: var(--accent);
    font-family: ui-monospace, 'Cascadia Mono', 'SF Mono', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
    line-height: 1.15;
  }

  .term__out :global(.term-line--error) {
    color: var(--negative);
  }

  .term__out :global(.term-line--dim) {
    color: var(--text-3);
  }

  .term__input-row {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-1);
  }

  .term__prompt {
    white-space: nowrap;
    cursor: text;
  }

  .term__user {
    color: var(--accent);
  }

  .term__colon {
    color: var(--text-3);
  }

  .term__input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font: inherit;
    caret-color: var(--accent);
  }

  /* The window shows focus, since the input itself has no box. */
  .term:focus-within {
    border-color: rgba(0, 255, 157, 0.4);
  }

  /* --- nano: takes the place of the shell while open --- */

  :global(#term:has(#nano:not([hidden]))) .term__body {
    display: none;
  }

  .nano {
    display: flex;
    flex-direction: column;
    height: 24rem;
    font-size: var(--fs-sm);
  }

  .nano[hidden] {
    display: none;
  }

  .nano__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--s-4);
    padding: 0 var(--s-4);
    line-height: 1.75rem;
    background: var(--text);
    color: var(--bg);
  }

  .nano__file {
    overflow: hidden;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nano__text {
    flex: 1;
    min-height: 0;
    padding: var(--s-3) var(--s-4);
    resize: none;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--text);
    font: inherit;
    line-height: 1.6;
    caret-color: var(--accent);
  }

  .nano__status {
    min-height: 1.6em;
    padding: 0 var(--s-4);
    text-align: center;
    color: var(--accent);
  }

  .nano__keys {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    padding: var(--s-2) var(--s-4) var(--s-3);
    border-top: 1px solid var(--line);
  }

  .nano__keys :global(button) {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2rem;
    padding: 0 var(--s-1);
    background: none;
    border: 0;
    color: var(--text-2);
    font: inherit;
    font-size: var(--fs-xs);
  }

  .nano__keys :global(button:hover) {
    color: var(--text);
  }

  .nano__keys :global(kbd) {
    padding: 0 var(--s-1);
    background: var(--text);
    color: var(--bg);
    font: inherit;
  }

  @media (max-width: 560px) {
    .nano {
      height: 20rem;
      font-size: var(--fs-xs);
    }

    .nano__text {
      font-size: 16px;
    }

    .term__body {
      height: 20rem;
      padding: var(--s-3) var(--s-4);
      font-size: var(--fs-xs);
    }

    /* 16px keeps iOS from zooming into the field. */
    .term__input {
      font-size: 16px;
    }

    .term__user {
      display: none;
    }
  }
</style>

<script>
  // The shell (~20 KB) is kept off the critical path: it loads when its
  // section gets close, on the first interaction with it, or once the
  // browser is idle after the page load — whichever comes first.
  const section = document.getElementById('terminal');
  let loaded = false;
  const load = () => {
    if (loaded) return;
    loaded = true;
    void import('../scripts/terminal');
  };
  if (!section || !('IntersectionObserver' in window)) {
    load();
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        load();
      },
      { rootMargin: '800px 0px' }
    );
    io.observe(section);
    section.addEventListener('pointerdown', load, { once: true });
    section.addEventListener('focusin', load, { once: true });
    const idle = window.requestIdleCallback ?? ((fn: () => void) => window.setTimeout(fn, 1));
    window.addEventListener('load', () => window.setTimeout(() => idle(load), 3000), { once: true });
  }
</script>
