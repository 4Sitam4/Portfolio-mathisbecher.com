---
import SectionHeading from './SectionHeading.astro';
import Window from './Window.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const suggestions = ['help', 'whoami', 'neofetch', 'ls projects', 'cat skills.json', 'matrix'];
---

<section id="terminal" class="section">
  <div class="container">
    <SectionHeading title={t('term.title')} />

    <div class="term-intro">
      <p class="term-intro__hint">{t('term.hint')}</p>
      <ul class="term-intro__cmds">
        {
          suggestions.map((cmd) => (
            <li>
              <button type="button" class="kbd term-intro__cmd" data-term-cmd={cmd}>
                {cmd}
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <Window id="term" title="visitor@mathisbecher.com: ~" class="term">
      <div id="term-body" class="term__body">
        <div id="term-out" class="term__out" role="log" aria-live="polite"></div>
        <div class="term__input-row">
          <label class="term__prompt" for="term-input">
            <span class="term__user">visitor@mathisbecher</span><span class="term__colon">:~$</span>
          </label>
          <input
            id="term-input"
            class="term__input"
            type="text"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="send"
            aria-label={t('term.input')}
          />
        </div>
      </div>
    </Window>
  </div>
</section>

<style>
  .term-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
    margin-bottom: var(--s-5);
  }

  .term-intro__hint {
    color: var(--text-2);
  }

  .term-intro__cmds {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .term-intro__cmd {
    min-height: 2rem;
    padding: 0 var(--s-3);
    font-size: var(--fs-sm);
    transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .term-intro__cmd:hover {
    background: #18221d;
    border-color: rgba(228, 237, 232, 0.22);
  }

  .term-intro__cmd:active {
    transform: translateY(1px);
  }

  .term__body {
    height: 24rem;
    overflow-y: auto;
    padding: var(--s-4) var(--s-5);
    font-size: var(--fs-sm);
    line-height: 1.7;
    cursor: text;
  }

  .term__out {
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--text);
  }

  .term__out :global(.term-line--accent) {
    color: var(--accent);
  }

  .term__out :global(.term-line--art) {
    color: var(--accent);
    font-family: ui-monospace, 'Cascadia Mono', 'SF Mono', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
    line-height: 1.15;
  }

  .term__out :global(.term-line--error) {
    color: var(--negative);
  }

  .term__out :global(.term-line--dim) {
    color: var(--text-3);
  }

  .term__input-row {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-1);
  }

  .term__prompt {
    white-space: nowrap;
    cursor: text;
  }

  .term__user {
    color: var(--accent);
  }

  .term__colon {
    color: var(--text-3);
  }

  .term__input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font: inherit;
    caret-color: var(--accent);
  }

  /* The window shows focus, since the input itself has no box. */
  .term:focus-within {
    border-color: rgba(0, 255, 157, 0.4);
  }

  @media (max-width: 560px) {
    .term__body {
      height: 20rem;
      padding: var(--s-3) var(--s-4);
      font-size: var(--fs-xs);
    }

    /* 16px keeps iOS from zooming into the field. */
    .term__input {
      font-size: 16px;
    }

    .term__user {
      display: none;
    }
  }
</style>

<script>
  import '../scripts/terminal';
</script>
