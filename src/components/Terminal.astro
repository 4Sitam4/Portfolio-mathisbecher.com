---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="terminal" class="section container">
  <h2 class="section-heading">
    <span class="index mono">06.</span>
    <span data-decrypt>{t('term.title')}</span>
  </h2>

  <p class="code-comment" data-reveal style="margin-bottom: var(--space-4);">
    // {t('term.hint')}
  </p>

  <div id="term" class="term card mono" data-reveal>
    <div class="term__bar">
      <span class="term__dot" style="background: var(--dot-red)"></span>
      <span class="term__dot" style="background: var(--dot-yellow)"></span>
      <span class="term__dot" style="background: var(--dot-green)"></span>
      <span class="term__title">visitor@mathisbecher.com: ~</span>
    </div>

    <div id="term-body" class="term__body">
      <div id="term-out" class="term__out" role="log" aria-live="polite"></div>
      <div class="term__input-row">
        <label class="term__prompt" for="term-input">
          <span class="accent">visitor@mathisbecher</span><span class="term__colon">:~$</span>
        </label>
        <input
          id="term-input"
          class="term__input"
          type="text"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="send"
          aria-label={lang === 'fr' ? 'Invite de commande' : 'Command prompt'}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .term {
    padding: 0;
    overflow: hidden;
    background: var(--bg-terminal, #040705);
  }

  .term:hover {
    transform: none;
  }

  .term__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.6rem 0.9rem;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--border);
  }

  .term__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .term__title {
    margin-inline: auto;
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }

  .term__body {
    height: 22rem;
    overflow-y: auto;
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
    line-height: 1.7;
    cursor: text;
  }

  .term__out {
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--text);
  }

  .term__out :global(.term-line--accent) {
    color: var(--green);
  }

  .term__out :global(.term-line--error) {
    color: var(--dot-red);
  }

  .term__out :global(.term-line--dim) {
    color: var(--text-muted);
  }

  .term__input-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .term__prompt {
    white-space: nowrap;
    cursor: text;
  }

  .term__colon {
    color: var(--text-muted);
  }

  .term__input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--green);
    font: inherit;
    caret-color: var(--green);
  }

  .term__input:focus {
    outline: none;
  }
</style>

<script>
  import '../scripts/terminal';
</script>
