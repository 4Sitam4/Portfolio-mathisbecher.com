---
/** A UI icon (Lucide subset, see icons.ts). Decorative: hidden from assistive tech. */
import { UI, type UiIcon } from './icons';

interface Props {
  name: UiIcon;
  class?: string;
}

const { name, class: cls } = Astro.props;
---

<svg
  class:list={['icon', cls]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={UI[name]}
/>
