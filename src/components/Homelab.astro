---
import SectionHeading from './SectionHeading.astro';
import Rich from './Rich.astro';
import Window from './Window.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const HERE = '◀── ';

const diagram = `
            INTERNET
                │
                ▼
     ┌─────────────────────┐
     │ cloudflare  (proxy) │
     └──────────┬──────────┘
                │
     ┌──────────┴──────────┐
     │  router / firewall  │
     └──────────┬──────────┘
                │ 10 Gbps
     ┌──────────┴──────────┐
     │     switch 10GbE    │
     └──┬───────┬───────┬──┘
        │       │       │
 ┌──────┴─────┐ │ ┌─────┴───────┐
 │ pve-node-* │ │ │   truenas   │
 │ Proxmox VE │ │ │ TrueNAS     │
 │  cluster   │ │ │ Scale       │
 └──────┬─────┘ │ └─────────────┘
        │       │
 ┌──────┴───────┴──────────────┐
 │ VMs · LXC · Docker          │
 │ ├─ nginx ── mathisbecher.com│ ${HERE}${t('homelab.here')}
 │ ├─ *arr stack               │
 │ └─ ...                      │
 └─────────────────────────────┘
`
  .trim()
  .split('\n')
  .map((line) => {
    const at = line.indexOf(HERE);
    return at === -1 ? { text: line } : { text: line.slice(0, at), pointer: line.slice(at) };
  });

const specs = [
  { value: t('homelab.stat1.value'), label: t('homelab.stat1.label') },
  { value: t('homelab.stat2.value'), label: t('homelab.stat2.label') },
  { value: t('homelab.stat3.value'), label: t('homelab.stat3.label') },
  { value: t('homelab.stat4.value'), label: t('homelab.stat4.label') },
];
---

<section id="homelab" class="section">
  <div class="container">
    <SectionHeading title={t('homelab.title')} name="homelab" />
    <p class="section-lede" data-provision="homelab.intro"><Rich text={t('homelab.intro')} /></p>

    <div class="homelab">
      <dl class="specs" data-provision="homelab.specs">
        {
          specs.map((spec) => (
            <div class="specs__row">
              <dt class="specs__label">{spec.label}</dt>
              <dd class="specs__value mono">{spec.value}</dd>
            </div>
          ))
        }
      </dl>

      <figure class="homelab__diagram" data-provision="homelab.topology">
        <Window title="~/homelab/topology.txt">
          <pre class="diagram ascii" aria-hidden="true">{diagram.map((line) => (
            <span class:list={['diagram__line', line.pointer && 'diagram__here']}>{line.text}{line.pointer && <span class="diagram__pointer">{line.pointer}</span>}</span>
          ))}</pre>
        </Window>
        <figcaption class="visually-hidden">{t('homelab.diagram')}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .homelab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: var(--s-8);
    align-items: start;
  }

  .specs {
    border-top: 1px solid var(--line);
  }

  .specs__row {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--line);
  }

  .specs__value {
    order: -1;
    margin: 0;
    font-size: var(--fs-xl);
    font-weight: 500;
    color: var(--text);
  }

  .specs__label {
    font-size: var(--fs-sm);
    color: var(--text-3);
  }

  .homelab__diagram {
    min-width: 0;
  }

  .diagram {
    padding: var(--s-5);
    font-size: clamp(0.625rem, 0.45rem + 0.6vw, 0.8125rem);
    color: var(--text-3);
    overflow-x: auto;
  }

  .diagram__line {
    display: block;
    min-height: 1.3em;
  }

  .diagram__here {
    color: var(--text);
  }

  .diagram__pointer {
    color: var(--accent);
  }

  @media (max-width: 1000px) {
    .homelab {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-7);
    }

    .specs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s-5);
    }
  }
</style>
