---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const diagram = `
            INTERNET
                │
                ▼
     ┌─────────────────────┐
     │   router / firewall │
     └──────────┬──────────┘
                │ 10 Gbps
     ┌──────────┴──────────┐
     │     switch 10GbE    │
     └──┬───────┬───────┬──┘
        │       │       │
 ┌──────┴─────┐ │ ┌─────┴───────┐
 │ pve-node-* │ │ │   truenas   │
 │ Proxmox VE │ │ │ TrueNAS     │
 │  cluster   │ │ │ Scale       │
 └──────┬─────┘ │ └─────────────┘
        │       │
 ┌──────┴───────┴──────────────┐
 │ VMs · LXC · Docker          │
 │ ├─ nginx ── mathisbecher.com│ ◀── ${lang === 'fr' ? 'vous êtes ici' : 'you are here'}
 │ ├─ *arr stack               │
 │ └─ ...                      │
 └─────────────────────────────┘
`.trim();

const stats = [
  { value: t('homelab.stat1.value'), label: t('homelab.stat1.label') },
  { value: t('homelab.stat2.value'), label: t('homelab.stat2.label') },
  { value: t('homelab.stat3.value'), label: t('homelab.stat3.label') },
  { value: t('homelab.stat4.value'), label: t('homelab.stat4.label') },
];
---

<section id="homelab" class="section container">
  <h2 class="section-heading">
    <span class="index mono">05.</span>
    <span data-decrypt>{t('homelab.title')}</span>
  </h2>

  <p class="homelab__intro" data-reveal>{t('homelab.intro')}</p>

  <div class="homelab__grid">
    <div class="homelab__stats" data-reveal-group>
      {
        stats.map((stat) => (
          <div class="homelab__stat card">
            <span class="homelab__value mono">{stat.value}</span>
            <span class="homelab__label">{stat.label}</span>
          </div>
        ))
      }
    </div>

    <figure class="homelab__diagram card" data-reveal>
      <pre class="mono" aria-hidden="true">{diagram}</pre>
      <figcaption class="visually-hidden">
        {lang === 'fr'
          ? 'Schéma du homelab : internet, routeur, switch 10GbE, cluster Proxmox, TrueNAS Scale, containers Docker.'
          : 'Homelab diagram: internet, router, 10GbE switch, Proxmox cluster, TrueNAS Scale, Docker containers.'}
      </figcaption>
    </figure>
  </div>

  <p class="code-comment" data-reveal style="margin-top: var(--space-4);">{t('homelab.note')}</p>
</section>

<style>
  .homelab__intro {
    max-width: 60ch;
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }

  .homelab__grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-4);
    align-items: start;
  }

  .homelab__stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .homelab__stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .homelab__value {
    font-size: var(--fs-xl);
    font-weight: 700;
    color: var(--green);
    text-shadow: 0 0 20px var(--green-soft);
  }

  .homelab__label {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .homelab__diagram {
    overflow-x: auto;
    background: var(--bg-terminal, #040705);
  }

  .homelab__diagram pre {
    font-size: clamp(0.6rem, 1.4vw, 0.8rem);
    line-height: 1.5;
    color: var(--text-muted);
    text-shadow: 0 0 12px var(--green-soft);
  }

  @media (max-width: 900px) {
    .homelab__grid {
      grid-template-columns: 1fr;
    }

    .homelab__stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .homelab__stats {
      grid-template-columns: 1fr;
    }
  }
</style>
