---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const skipLabel = lang === 'fr' ? 'Échap pour passer' : 'Esc to skip';
const skipButton = lang === 'fr' ? 'Passer' : 'Skip';
---

<div id="boot" class="boot">
  <pre class="boot__log mono" id="boot-log" aria-hidden="true"></pre>
  <p class="boot__skip mono" aria-hidden="true">{skipLabel}</p>
  <!-- Touch screens have no Escape key: a real button, and only there
       (a tap anywhere else still does not cut the show short). -->
  <button type="button" class="boot__skip-btn mono" id="boot-skip">
    {skipButton}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 17 5-5-5-5" /><path d="m13 17 5-5-5-5" />
    </svg>
  </button>
</div>

<style>
  .boot {
    position: fixed;
    inset: 0;
    z-index: var(--z-boot);
    display: none;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1rem, 6vw, 4rem);
    background: var(--bg-deep);
  }

  /* Shown only when JS is running (the `js` class is set by an inline script
     in Base.astro), so a visitor without JS never sees a black screen. */
  :global(html.js:not([data-booted='true'])) .boot {
    display: flex;
  }

  /* Stays displayed while it switches off, even though the page is booted. */
  :global(html.js) .boot.boot--off {
    display: flex;
    animation: boot-off 450ms cubic-bezier(0.55, 0, 0.45, 1) forwards;
  }

  @keyframes boot-off {
    0% {
      transform: scale(1, 1);
      filter: brightness(1);
      opacity: 1;
    }
    55% {
      transform: scale(1, 0.004);
      filter: brightness(3);
      opacity: 1;
    }
    100% {
      transform: scale(0, 0.004);
      filter: brightness(3);
      opacity: 0;
    }
  }

  .boot__log {
    font-size: clamp(0.65rem, 1.8vw, 0.85rem);
    line-height: 1.7;
    color: var(--text-2);
    white-space: pre-wrap;
    overflow: hidden;
  }

  .boot__log :global(.ok) {
    color: var(--accent);
  }

  .boot__log :global(.dim) {
    color: var(--text-3);
  }

  .boot__skip {
    position: absolute;
    bottom: 1.5rem;
    right: 1.5rem;
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  .boot__skip-btn {
    display: none;
  }

  @media (hover: none) and (pointer: coarse) {
    .boot__skip {
      display: none;
    }

    .boot__skip-btn {
      position: absolute;
      right: 1rem;
      bottom: max(1rem, env(safe-area-inset-bottom));
      display: inline-flex;
      align-items: center;
      gap: var(--s-2);
      min-height: 2.75rem;
      padding: 0 var(--s-4);
      font-size: var(--fs-sm);
      color: var(--text);
      background: var(--raised);
      border: 1px solid var(--line-strong);
      border-radius: var(--r-md);
    }

    .boot__skip-btn svg {
      width: 16px;
      height: 16px;
    }
  }
</style>


<script>
  /**
   * Boot sequence (every visit; reading mode and reduced motion skip it):
   * the homelab comes up, then
   * `terraform apply` is typed and the overlay fades into the page being
   * provisioned (provision.ts). Escape skips everything.
   */
  const boot = document.getElementById('boot');
  const log = document.getElementById('boot-log');

  const LINES_FR = [
    'BIOS mathisbecher.com v2.0 — POST........... OK',
    'Démarrage de proxmox-cluster.service',
    'Démarrage de truenas-scale.service',
    'Réseau actif — liaison 10 Gbps établie',
    'Montage de /dev/compétences (terraform, azure, docker)',
    'Extraction du container : portfolio:latest',
    'nginx démarré — servi depuis le homelab',
  ];

  const LINES_EN = [
    'BIOS mathisbecher.com v2.0 — POST........... OK',
    'Starting proxmox-cluster.service',
    'Starting truenas-scale.service',
    'Network up — 10 Gbps link established',
    'Mounting /dev/skills (terraform, azure, docker)',
    'Pulling container: portfolio:latest',
    'nginx started — serving from the homelab',
  ];

  const COMMAND = 'terraform apply -auto-approve';

  function line(cls: string, ...parts: (string | Node)[]): HTMLElement {
    const span = document.createElement('span');
    if (cls) span.className = cls;
    span.append(...parts);
    log!.append(span, document.createTextNode('\n'));
    return span;
  }

  function tag(cls: string, text: string): HTMLElement {
    const s = document.createElement('span');
    s.className = cls;
    s.textContent = text;
    return s;
  }

  function finish(skipped: boolean): void {
    document.documentElement.dataset.booted = 'true';
    window.dispatchEvent(new CustomEvent('boot:done', { detail: { skipped } }));
  }

  if (document.documentElement.dataset.booted === 'true' || !boot || !log) {
    boot?.remove();
  } else {
    document.body.style.overflow = 'hidden';
    const lines = document.documentElement.lang === 'fr' ? LINES_FR : LINES_EN;
    const resources = document.querySelectorAll('[data-provision]').length;
    let timer = 0;
    let done = false;

    const end = (skipped: boolean) => {
      if (done) return;
      done = true;
      clearTimeout(timer);
      document.body.style.overflow = '';
      window.removeEventListener('keydown', onKey);
      // The scroll lock swallowed any #anchor navigation — replay it now.
      // By id, never as a selector: a crafted hash (#1x) must not throw here.
      if (location.hash) {
        try {
          document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();
        } catch {
          /* malformed hash: ignore */
        }
      }
      // Natural end: the screen switches off like a CRT while the page
      // starts building underneath. Skipped: it just disappears.
      boot.style.pointerEvents = 'none';
      if (skipped) boot.style.opacity = '0';
      else boot.classList.add('boot--off');
      finish(skipped);
      window.setTimeout(() => boot.remove(), skipped ? 0 : 480);
    };

    // Only Escape skips: clicks and other keys no longer cut the show short.
    const onKey = (e: KeyboardEvent) => {
      if (e.key !== 'Escape') return;
      e.preventDefault();
      end(true);
    };

    const after = (ms: number, fn: () => void) => {
      timer = window.setTimeout(fn, ms);
    };

    const plan = () => {
      line('', tag('dim', `Plan: `), tag('ok', `${resources} to add`), tag('dim', ', 0 to change, 0 to destroy.'));
      after(200, () => {
        line('dim', 'Applying…');
        after(280, () => end(false));
      });
    };

    const typeCommand = () => {
      line('');
      const prompt = line('', tag('ok', 'visitor@homelab'), tag('dim', ':~$ '));
      const typed = document.createElement('span');
      prompt.append(typed);
      let i = 0;
      const step = () => {
        typed.textContent = COMMAND.slice(0, ++i);
        if (i < COMMAND.length) after(14 + Math.random() * 24, step);
        else after(175, plan);
      };
      after(160, step);
    };

    let index = 0;
    const next = () => {
      if (index >= lines.length) return typeCommand();
      line('', tag('ok', '[  OK  ] '), lines[index]!);
      index++;
      after(44 + Math.random() * 72, next);
    };

    window.addEventListener('keydown', onKey);
    document.getElementById('boot-skip')?.addEventListener('click', () => end(true), { once: true });
    next();

    // Hard cap: never hold the visitor hostage for more than 4s.
    window.setTimeout(() => end(false), 4000);
  }
</script>
