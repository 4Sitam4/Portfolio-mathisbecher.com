---
import { useTranslations, skillGroups, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="skills" class="section container">
  <h2 class="section-heading">
    <span class="index mono">03.</span>
    <span data-decrypt>{t('skills.title')}</span>
  </h2>

  <div class="skills" data-reveal-group>
    {
      skillGroups.map((group) => (
        <div class="skills__group card">
          <p class="skills__prompt mono">
            <span class="accent">$</span> {group.prompt}
          </p>
          <h3 class="skills__name mono">{t(group.key)}</h3>
          <ul class="skills__list">
            {group.items.map((item) => (
              <li class="tag">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .skills__prompt {
    font-size: var(--fs-xs);
    color: var(--text-faint);
    margin-bottom: var(--space-2);
  }

  .skills__name {
    font-size: var(--fs-lg);
    color: var(--green);
    margin-bottom: var(--space-3);
  }

  .skills__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (max-width: 760px) {
    .skills {
      grid-template-columns: 1fr;
    }
  }
</style>
