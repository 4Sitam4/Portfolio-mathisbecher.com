---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: '#about', label: t('nav.about') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#skills', label: t('nav.skills') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#homelab', label: t('nav.homelab') },
  { href: '#terminal', label: t('nav.terminal') },
  { href: '#contact', label: t('nav.contact') },
];

const otherLangHref = lang === 'fr' ? '/en/' : '/';
const otherLangLabel = lang === 'fr' ? 'EN' : 'FR';
---

<header class="nav">
  <div class="container nav__inner">
    <a href="#top" class="nav__logo mono glitch" data-text="mb@homelab:~$">mb@homelab:~$</a>

    <nav aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      <button
        id="nav-toggle"
        class="nav__toggle mono"
        aria-expanded="false"
        aria-controls="nav-links"
      >
        [{t('nav.menu')}]
      </button>
      <ul id="nav-links" class="nav__links mono">
        {
          links.map((link, i) => (
            <li>
              <a href={link.href}>
                <span class="nav__index">0{i + 1}.</span>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={otherLangHref} class="nav__lang" rel="alternate" hreflang={lang === 'fr' ? 'en' : 'fr'}>
            [{otherLangLabel}]
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    background: rgba(6, 10, 8, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    height: 4rem;
  }

  .nav__logo {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--green);
    white-space: nowrap;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    font-size: var(--fs-sm);
  }

  .nav__links a {
    color: var(--text-muted);
  }

  .nav__links a:hover,
  .nav__links a:focus-visible {
    color: var(--green);
  }

  .nav__index {
    color: var(--green-dim);
    font-size: var(--fs-xs);
    margin-right: 2px;
  }

  .nav__lang {
    color: var(--green) !important;
    font-weight: 700;
  }

  .nav__toggle {
    display: none;
    background: none;
    border: none;
    color: var(--green);
    font-size: var(--fs-sm);
    padding: var(--space-2);
  }

  @media (max-width: 900px) {
    .nav__toggle {
      display: block;
    }

    .nav__links {
      position: absolute;
      top: 4rem;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: var(--space-3) var(--space-4) var(--space-4);
      background: rgba(6, 10, 8, 0.97);
      border-bottom: 1px solid var(--border);
      display: none;
    }

    .nav__links.is-open {
      display: flex;
    }

    .nav__links li {
      width: 100%;
    }

    .nav__links a {
      display: block;
      padding: var(--space-2) 0;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');

  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(open)));
  });

  // Close the mobile menu after navigating to a section.
  links?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      links.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
