---
import SectionHeading from './SectionHeading.astro';
import Window from './Window.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="section">
  <div class="container">
    <SectionHeading title={t('about.title')} />

    <div class="about">
      <div class="about__text">
        <p class="about__lead">{t('about.p1')}</p>
        <p>{t('about.p2')}</p>
        <p>{t('about.p3')}</p>
      </div>

      <Window title="whoami.yaml" class="about__card">
        <pre class="about__code"><code><span class="k">name</span>: Mathis Becher
<span class="k">role</span>: cloud_infrastructure_engineer
<span class="k">company</span>: open-lake-technology
<span class="k">school</span>: epitech
<span class="k">graduation</span>: <span class="v">2027</span>
<span class="k">location</span>: Strasbourg, FR
<span class="k">interests</span>:
  - self_hosting
  - infrastructure_as_code
  - digital_independence
<span class="k">homelab</span>: <span class="v">true</span></code></pre>
      </Window>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--s-8);
    align-items: start;
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    max-width: 62ch;
    color: var(--text-2);
  }

  .about__lead {
    font-size: var(--fs-lg);
    color: var(--text);
  }

  .about__code {
    padding: var(--s-5);
    font-size: var(--fs-sm);
    line-height: 1.8;
    color: var(--text-2);
    overflow-x: auto;
  }

  .about__code .k {
    color: var(--text-3);
  }

  .about__code .v {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-7);
    }
  }
</style>
