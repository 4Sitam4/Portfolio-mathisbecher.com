---
/**
 * Hero background: interactive matrix rain. Masked so it stays quiet behind
 * the headline (left) and fades into the page at the bottom. Pauses
 * off-screen and when the tab is hidden.
 */
---

<canvas id="matrix-hero" class="matrix-hero" aria-hidden="true"></canvas>

<style>
  .matrix-hero {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    --mask-x: linear-gradient(to right, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.35) 40%, #000 80%);
    --mask-y: linear-gradient(to bottom, #000 0%, #000 50%, transparent 100%);
    -webkit-mask-image: var(--mask-x), var(--mask-y);
    -webkit-mask-composite: source-in;
    mask-image: var(--mask-x), var(--mask-y);
    mask-composite: intersect;
  }

  @media (max-width: 1100px) {
    .matrix-hero {
      opacity: 0.35;
    }
  }
</style>

<script>
  import { MatrixRain } from '../scripts/matrix';

  const canvas = document.getElementById('matrix-hero') as HTMLCanvasElement | null;

  if (canvas) {
    const rain = new MatrixRain(canvas, { intensity: 0.45 });
    const hero = canvas.parentElement!;

    hero.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const rect = canvas.getBoundingClientRect();
      rain.setMouseX(e.clientX - rect.left);
    });
    hero.addEventListener('pointerleave', () => rain.setMouseX(-1));

    // Only animate while the hero is on screen.
    new IntersectionObserver(
      ([entry]) => (entry?.isIntersecting ? rain.start() : rain.stop()),
      { threshold: 0.05 }
    ).observe(canvas);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) rain.stop();
      else rain.start();
    });

    window.addEventListener('matrix:boost', () => rain.boost());
  }
</script>
