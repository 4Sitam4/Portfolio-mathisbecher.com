---
/**
 * Hero background: interactive matrix rain, even across the whole width (it
 * builds the portrait: holo3d.ts), ending with a ragged edge at the bottom of
 * the first screen. Pauses off-screen and when the tab is hidden.
 */
---

<canvas id="matrix-hero" class="matrix-hero" aria-hidden="true"></canvas>

<style>
  .matrix-hero {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    /* no mask: the same everywhere; the rain itself ends, raggedly, at the
       bottom of the first screen (matrix.ts) */
  }

  @media (max-width: 1100px) {
    .matrix-hero {
      opacity: 0.35;
    }
  }
</style>

<script>
  import { MatrixRain, setHeroRain } from '../scripts/matrix';

  const canvas = document.getElementById('matrix-hero') as HTMLCanvasElement | null;

  if (canvas) {
    // Phones: lighter rain (no hi-dpi buffers, fewer frames).
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const rain = new MatrixRain(canvas, { intensity: 0.46, fontSize: 13, fps: coarse ? 20 : 28, maxDpr: coarse ? 1 : 1.5 });
    const hero = canvas.parentElement!;
    setHeroRain(rain, canvas); // the portrait is built by this rain (holo3d.ts)

    hero.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const rect = canvas.getBoundingClientRect();
      rain.setMouseX(e.clientX - rect.left);
    });
    hero.addEventListener('pointerleave', () => rain.setMouseX(-1));

    // Only animate while the hero is on screen, and not under the boot
    // overlay that hides it anyway.
    const watch = () =>
      new IntersectionObserver(([entry]) => (entry?.isIntersecting ? rain.start() : rain.stop()), {
        threshold: 0.05,
      }).observe(canvas);
    if (document.documentElement.dataset.booted === 'true' || !document.getElementById('boot')) watch();
    else window.addEventListener('boot:done', watch, { once: true });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) rain.stop();
      else rain.start();
    });

    window.addEventListener('matrix:boost', (e) => rain.boost((e as CustomEvent<number | undefined>).detail));
  }
</script>
