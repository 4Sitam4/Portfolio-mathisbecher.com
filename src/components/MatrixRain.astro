---
/**
 * Hero background: interactive matrix rain, masked so it fades into the page
 * background. Pauses off-screen and when the tab is hidden.
 */
---

<canvas id="matrix-hero" class="matrix-hero" aria-hidden="true"></canvas>

<style>
  .matrix-hero {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.55;
    mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
  }
</style>

<script>
  import { MatrixRain } from '../scripts/matrix';

  const canvas = document.getElementById('matrix-hero') as HTMLCanvasElement | null;

  if (canvas) {
    const rain = new MatrixRain(canvas, { intensity: 0.45 });
    const hero = canvas.parentElement!;

    hero.addEventListener('pointermove', (e) => {
      const rect = canvas.getBoundingClientRect();
      rain.setMouseX(e.clientX - rect.left);
    });
    hero.addEventListener('pointerleave', () => rain.setMouseX(-1));

    // Only animate while the hero is on screen.
    new IntersectionObserver(
      ([entry]) => (entry?.isIntersecting ? rain.start() : rain.stop()),
      { threshold: 0.05 }
    ).observe(canvas);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) rain.stop();
      else rain.start();
    });

    window.addEventListener('matrix:boost', () => rain.boost());
  }
</script>
