---
import { useTranslations, projects, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="projects" class="section container">
  <h2 class="section-heading">
    <span class="index mono">04.</span>
    <span data-decrypt>{t('projects.title')}</span>
  </h2>

  <div class="projects" data-reveal-group>
    {
      projects.map((project) => (
        <article class="projects__card card">
          <header class="projects__header mono">
            <span class="projects__prefix accent" aria-hidden="true">
              &gt;
            </span>
            <h3 class="projects__name">{project.name}</h3>
            {typeof project.stars === 'number' && project.stars > 10 && (
              <span class="projects__stars" title="GitHub stars">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
                </svg>
                {project.stars}
              </span>
            )}
            {project.archived && <span class="projects__archived">{t('projects.archived')}</span>}
          </header>

          <p class="projects__desc">{project.description[lang]}</p>

          <footer class="projects__footer">
            <div class="projects__tags">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            {project.url && (
              <a
                class="projects__link mono"
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${project.name} — ${t('projects.source')}`}
              >
                {t('projects.source')} ↗
              </a>
            )}
          </footer>
        </article>
      ))
    }
  </div>
</section>

<style>
  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .projects__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .projects__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .projects__prefix {
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .projects__card:hover .projects__prefix {
    opacity: 1;
    transform: translateX(0);
  }

  .projects__name {
    font-size: var(--fs-lg);
  }

  .projects__stars {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--fs-xs);
    color: var(--green);
  }

  .projects__archived {
    font-size: var(--fs-xs);
    color: var(--text-faint);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
  }

  .projects__desc {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    flex: 1;
  }

  .projects__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .projects__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .projects__link {
    font-size: var(--fs-sm);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>
