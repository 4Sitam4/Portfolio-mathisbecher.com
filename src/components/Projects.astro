---
import SectionHeading from './SectionHeading.astro';
import Rich from './Rich.astro';
import WorkCases from './WorkCases.astro';
import { useTranslations, projects, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The most-starred project leads; the rest follow in a compact row.
const [featured, ...rest] = [...projects].sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0));
const starFmt = new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-GB');
---

<section id="projects" class="section">
  <div class="container">
    <SectionHeading title={t('projects.title')} name="projects" />

    <h3 class="subpath" data-provision="projects.work.title">
      <span class="subpath__root" aria-hidden="true">~/{t('projects.title')}/</span>{t('projects.work')}
    </h3>
    <p class="subpath__lede" data-provision="projects.work.lede"><Rich text={t('projects.work.lede')} /></p>
    <WorkCases lang={lang} />

    <h3 class="subpath subpath--next" data-provision="projects.perso.title">
      <span class="subpath__root" aria-hidden="true">~/{t('projects.title')}/</span>{t('projects.perso')}
    </h3>

    {
      featured && (
        <article class="feature" data-provision="projects.featured">
          <div class="feature__text">
            <h4 class="feature__name">
              {featured.name}
              {featured.archived && <span class="archived">{t('projects.archived')}</span>}
            </h4>
            <p class="feature__desc"><Rich text={featured.description[lang]} /></p>
            <ul class="tags" aria-label="Technologies">
              {featured.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
            {featured.url && (
              <a class="btn feature__link" href={featured.url} target="_blank" rel="noopener noreferrer">
                {t('projects.source')}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7" /><path d="M8 7h9v9" />
                </svg>
              </a>
            )}
          </div>
          {typeof featured.stars === 'number' && (
            <p class="feature__figure">
              <span class="feature__stars num">{starFmt.format(featured.stars)}</span>
              <span class="feature__stars-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
                  <path d="m12 3 2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.6 6.6 19.5l1.2-6L3.3 9.3l6.1-.7Z" />
                </svg>
                {t('projects.stars')}
              </span>
            </p>
          )}
        </article>
      )
    }

    <ul class="projects">
      {
        rest.map((project, i) => {
          const href = project.anchor ?? project.url ?? project.live;
          const external = !project.anchor && Boolean(project.url ?? project.live);
          const cta = project.anchor ? t('projects.homelab') : project.url ? t('projects.source') : t('projects.live');
          return (
            <li class="project" data-provision={`projects.repo[${i}]`}>
              <h4 class="project__name">
                {href ? (
                  <a
                    class="project__link"
                    href={href}
                    target={external ? '_blank' : undefined}
                    rel={external ? 'noopener noreferrer' : undefined}
                  >
                    {project.name}
                  </a>
                ) : (
                  project.name
                )}
              </h4>
              <p class="project__desc"><Rich text={project.description[lang]} /></p>
              <ul class="tags" aria-label="Technologies">
                {project.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
              {href && (
                <span class="project__cta mono" aria-hidden="true">
                  {cta}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    {project.anchor ? <path d="M12 5v14M5 12l7 7 7-7" /> : <><path d="M7 17 17 7" /><path d="M8 7h9v9" /></>}
                  </svg>
                </span>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  /* --- Sub-paths: ~/projets/open-lake, ~/projets/perso --- */

  .subpath {
    margin-bottom: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xl);
    font-weight: 500;
    color: var(--text);
  }

  .subpath--next {
    margin-top: var(--s-8);
    margin-bottom: var(--s-5);
  }

  .subpath__root {
    color: var(--text-3);
  }

  .subpath__lede {
    max-width: 62ch;
    margin-bottom: var(--s-5);
    color: var(--text-2);
  }

  /* --- Featured project: the one figure that matters --- */

  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: center;
    padding: var(--s-7);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }

  .feature__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
  }

  .feature__name {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--fs-2xl);
    letter-spacing: -0.02em;
  }

  .archived {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--text-3);
  }

  .feature__desc {
    max-width: 52ch;
    color: var(--text-2);
    font-size: var(--fs-lg);
  }

  .feature__link {
    margin-top: var(--s-2);
  }

  .feature__figure {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--s-2);
    text-align: right;
  }

  .feature__stars {
    font-family: var(--font-mono);
    font-size: clamp(3.5rem, 2rem + 5vw, 6rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent);
  }

  .feature__stars-label {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--text-3);
  }

  .feature__stars-label svg {
    width: 16px;
    height: 16px;
  }

  /* --- The rest: a compact row --- */

  .projects {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    margin-top: var(--s-4);
  }

  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }

  .project:has(.project__link):hover {
    border-color: var(--line-strong);
    background: #0f1613;
  }

  .project__name {
    font-size: var(--fs-lg);
  }

  /* The whole card is clickable through the title link. */
  .project__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .project__link:focus-visible {
    outline: none;
  }

  .project:has(.project__link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .project__desc {
    flex: 1;
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .project__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-2);
    font-size: var(--fs-sm);
    color: var(--text-3);
    transition: color var(--dur-fast) var(--ease);
  }

  .project__cta svg {
    width: 16px;
    height: 16px;
  }

  .project:hover .project__cta {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--s-5);
    }

    .feature__figure {
      order: -1;
      align-items: flex-start;
      text-align: left;
    }

    .projects {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
